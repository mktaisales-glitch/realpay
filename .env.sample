# Copy to .env and fill in. Never commit .env.
# RealPay refuses to start against anything but the PayPal sandbox.

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
# Webhook id from the same app (needed to verify webhook signatures)
PAYPAL_WEBHOOK_ID=

# Sandbox accounts that receive payouts (required)
SUPPLIER_EMAIL=
CONTRACTOR_EMAIL=

# Free-tier AI providers, tried in order. Leave a key empty to skip that provider.
AI_PROVIDERS=gemini,openrouter
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# Hard cap on AI calls per UTC day (protects the free tiers)
AI_DAILY_CAP=150
# Share of that cap one project may use per day; the rest go to a person
AI_CALLS_PER_PROJECT_PER_DAY=10
# Instance-wide caps per UTC day, so a public demo cannot be flooded
PROJECTS_PER_DAY=300
DEMO_CARD_FUNDINGS_PER_DAY=100

# Server (defaults shown; uncomment to change)
# PORT=8080
# DATABASE_PATH=data/realpay.db
# UPLOAD_DIR=data/uploads
# Reverse proxies in front of the app: 0 locally, 1 behind Render or a load balancer
TRUST_PROXY=0

# Demo mode enables the sandbox test-card funding button, the
# "advance clock" control and the simulated dispute. Never enable in production.
DEMO_MODE=true
# A PayPal sandbox test card (developer.paypal.com > Testing Tools > Card Testing)
# Format: <card number>|<expiry YYYY-MM>
DEMO_TEST_CARD=
