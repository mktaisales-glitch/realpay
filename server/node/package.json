{
  "name": "realpay-server",
  "version": "0.1.0",
  "private": true,
  "description": "RealPay: milestone payments held by PayPal until AI-verified proof of work",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "format": "prettier . ../../client --write",
    "format:check": "prettier . ../../client --check",
    "lint": "eslint . && npm run lint:client && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "dotenvx run -f ../../.env --quiet -- tsx src/server.ts",
    "dev": "dotenvx run -f ../../.env --quiet -- tsx --watch src/server.ts",
    "start:prod": "node src/server.ts",
    "lint:client": "cd ../.. && eslint -c server/node/eslint.client.config.mjs client"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.38.2",
    "@paypal/paypal-server-sdk": "^2.5.0",
    "better-sqlite3": "^11.10.0",
    "exifr": "^7.1.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-unicorn": "^65.0.1",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  }
}
